msgid "Revoke All Devices"
msgstr "Ανάκληση όλων των συσκευών"

#: views/profile-trusted-devices.php:103
msgid "Revoking devices will require re-verification from those devices on the next login."
msgstr "Η ανάκληση συσκευών θα απαιτεί επανέλεγχο από αυτές τις συσκευές κατά την επόμενη σύνδεση."

#: views/settings-page.php:53
#: views/settings-page.php:54
msgid "2FA Mode"
msgstr "Λειτουργία 2FA"

#: views/settings-page.php:61
msgid "Disabled"
msgstr "Άτομα με αναπηρία"

#: views/settings-page.php:62
msgid "Two-factor authentication is disabled. Not recommended for production sites."
msgstr "Η επαλήθευση δύο παραγόντων είναι απενεργοποιημένη. Δεν συνιστάται για ιστότοπους παραγωγής."

#: views/settings-page.php:70
msgid "Enabled for all users"
msgstr "Ενεργοποιημένο για όλους τους χρήστες"

#: views/settings-page.php:71
msgid "All users, including subscribers, will be required to verify their identity."
msgstr "Όλοι οι χρήστες, συμπεριλαμβανομένων των συνδρομητών, θα πρέπει να επαληθεύσουν την ταυτότητά τους."

#: views/settings-page.php:79
msgid "Enabled for specific roles"
msgstr "Ενεργοποιημένο για συγκεκριμένους ρόλους"

#: views/settings-page.php:80
msgid "Only users with selected roles will be required to verify their identity."
msgstr "Μόνο οι χρήστες με επιλεγμένους ρόλους θα πρέπει να επαληθεύσουν την ταυτότητά τους."

#: views/settings-page.php:88
msgid "Protected Roles"
msgstr "Προστατευόμενοι ρόλοι"

#: views/settings-page.php:107
msgid "Select which user roles require two-factor authentication."
msgstr "Επιλέξτε ποιοι ρόλοι χρηστών απαιτούν έλεγχο ταυτότητας δύο παραγόντων."

#: views/settings-page.php:112
msgid "Verification Period"
msgstr "Περίοδος επαλήθευσης"

#: views/settings-page.php:115
#: views/settings-page.php:142
#: views/settings-page.php:205
#: views/settings-page.php:214
msgid "days"
msgstr "ημέρες"

#: views/settings-page.php:116
msgid "How often users need to re-verify their identity (1-365 days)."
msgstr "Πόσο συχνά οι χρήστες πρέπει να επαληθεύουν εκ νέου την ταυτότητά τους (1-365 ημέρες)."

#: views/settings-page.php:121
msgid "Code Length"
msgstr "Μήκος κώδικα"

#: views/settings-page.php:124
msgid "digits"
msgstr "ψηφία"

#: views/settings-page.php:125
msgid "Length of the verification code (4-8 digits)."
msgstr "Μήκος του κωδικού επαλήθευσης (4-8 ψηφία)."

#: views/settings-page.php:130
msgid "Code Expiry"
msgstr "Λήξη κωδικού"

#: views/settings-page.php:133
#: views/settings-page.php:151
msgid "minutes"
msgstr "λεπτά"

#: views/settings-page.php:134
msgid "How long verification codes remain valid (5-60 minutes)."
msgstr "Πόσο καιρό παραμένουν έγκυροι οι κωδικοί επαλήθευσης (5-60 λεπτά)."

#: views/settings-page.php:139
msgid "Trust Device Duration"
msgstr "Διάρκεια εμπιστοσύνης συσκευής"

#: views/settings-page.php:143
msgid "How long a trusted device remains trusted before requiring 2FA again (1-365 days)."
msgstr "Πόσο καιρό μια αξιόπιστη συσκευή παραμένει αξιόπιστη πριν απαιτηθεί ξανά η 2FA (1-365 ημέρες)."

#: views/settings-page.php:148
msgid "Auto-Lock Duration"
msgstr "Διάρκεια αυτόματου κλειδώματος"

#: views/settings-page.php:152
msgid "Duration to lock accounts after too many failed verification attempts (1-1440 minutes = 1 minute to 24 hours)."
msgstr "Διάρκεια κλειδώματος λογαριασμών μετά από πολλές αποτυχημένες προσπάθειες επαλήθευσης (1-1440 λεπτά = 1 λεπτό έως 24 ώρες)."

#: views/settings-page.php:158
msgid "Email Settings"
msgstr "Ρυθμίσεις ηλεκτρονικού ταχυδρομείου"

#: views/settings-page.php:163
msgid "From Name"
msgstr "Από Όνομα"

#: views/settings-page.php:166
msgid "The name that appears in the \"From\" field of verification emails."
msgstr "Το όνομα που εμφανίζεται στο πεδίο «Από» των email επαλήθευσης."

#: views/settings-page.php:171
msgid "From Address"
msgstr "Από τη διεύθυνση"

#: views/settings-page.php:174
msgid "The email address that appears in the \"From\" field of verification emails."
msgstr "Η διεύθυνση ηλεκτρονικού ταχυδρομείου που εμφανίζεται στο πεδίο «Από» των μηνυμάτων ηλεκτρονικού ταχυδρομείου επαλήθευσης."

#: views/settings-page.php:179
msgid "Email Subject"
msgstr "Θέμα email"

#: views/settings-page.php:182
msgid "Subject line for verification emails."
msgstr "Θέμα για τα email επαλήθευσης."

#: views/settings-page.php:188
msgid "Password Reminder Settings"
msgstr "Ρυθμίσεις υπενθύμισης κωδικού πρόσβασης"

#: views/settings-page.php:193
msgid "Password Reminders"
msgstr "Υπενθυμίσεις κωδικού πρόσβασης"

#: views/settings-page.php:196
msgid "Enable password change reminders"
msgstr "Ενεργοποίηση υπενθυμίσεων αλλαγής κωδικού πρόσβασης"

#: views/settings-page.php:197
msgid "Periodically remind users to update their passwords."
msgstr "Υπενθυμίζετε περιοδικά στους χρήστες να ενημερώνουν τους κωδικούς πρόσβασής τους."

#: views/settings-page.php:202
msgid "Reminder Period"
msgstr "Περίοδος υπενθύμισης"

#: views/settings-page.php:206
msgid "Remind users to change their password after this many days (30-365 days)."
msgstr "Υπενθυμίστε στους χρήστες να αλλάξουν τον κωδικό πρόσβασής τους μετά από τόσες ημέρες (30-365 ημέρες)."

#: views/settings-page.php:211
msgid "Reminder Cooldown"
msgstr "Υπενθύμιση χρόνου αναμονής"

#: views/settings-page.php:215
msgid "Wait this many days before showing the reminder again if dismissed (1-90 days)."
msgstr "Περιμένετε τόσες ημέρες πριν εμφανίσετε ξανά την υπενθύμιση, εάν απορριφθεί (1-90 ημέρες)."

#: views/verification-page.php:30
#: views/verification-page.php:58
msgid "Account Verification Required"
msgstr "Απαιτείται επαλήθευση λογαριασμού"

#: views/verification-page.php:61
msgid "Please enter the verification code sent to your email."
msgstr "Παρακαλώ εισάγετε τον κωδικό επαλήθευσης που σας στάλθηκε στο email σας."

#: views/verification-page.php:67
msgid "Verification Code:"
msgstr "Κωδικός επαλήθευσης:"

#. translators: %d: number of days
#: views/verification-page.php:73
#, php-format
msgid "Trust this device for %d day"
msgid_plural "Trust this device for %d days"
msgstr[0] ""
msgstr[1] ""

#: views/verification-page.php:80
msgid "Verify"
msgstr "Επαλήθευση"

#: views/verification-page.php:86
msgid "Resend Code"
msgstr "Επανάληψη αποστολής κωδικού"

#: views/password-page.php:54
msgid "It's been over a year since you last changed your password. For your security, we recommend updating it regularly."
msgstr "Έχει περάσει πάνω από ένας χρόνος από την τελευταία φορά που αλλάξατε τον κωδικό πρόσβασής σας. Για λόγους ασφαλείας, σας συνιστούμε να τον ανανεώνετε τακτικά."