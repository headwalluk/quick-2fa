#: includes/class-plugin.php:772
#, php-format
msgid "%s is currently disabled."
msgstr "Το %s είναι προς το παρόν απενεργοποιημένο."

#. translators: %s is the plugin name, Quick 2FA
#: includes/class-settings.php:422
#, php-format
msgid "%s Settings"
msgstr "Ρυθμίσεις %s"

#: includes/class-abilities.php:66
msgid "Read-only queries about two-factor authentication, passwords and account security."
msgstr "Ερωτήματα μόνο για ανάγνωση σχετικά με την επαλήθευση δύο παραγόντων, τους κωδικούς πρόσβασης και την ασφάλεια των λογαριασμών."

#: includes/class-abilities.php:84
msgid "The user: an ID, login name or email address."
msgstr "Ο χρήστης: ένας κωδικός ταυτότητας, ένα όνομα σύνδεσης ή μια διεύθυνση ηλεκτρονικού ταχυδρομείου."

#: includes/class-abilities.php:90
msgid "Get a user's security status"
msgstr "Λήψη της κατάστασης ασφάλειας ενός χρήστη"

#: includes/class-abilities.php:91
msgid "Returns when a user last changed their password, logged in and passed two-factor verification, whether two-factor authentication applies to them, whether their account is locked, and how many trusted devices they have. A null date means none has been recorded since Quick 2FA was installed."
msgstr "Επιστρέφει πότε ο χρήστης άλλαξε για τελευταία φορά τον κωδικό πρόσβασής του, πότε συνδέθηκε και πέρασε τον έλεγχο δύο παραγόντων, αν ισχύει για αυτόν η επαλήθευση δύο παραγόντων, αν ο λογαριασμός του είναι κλειδωμένος και πόσες αξιόπιστες συσκευές διαθέτει. Μια ημερομηνία null σημαίνει ότι δεν έχει καταγραφεί καμία από την εγκατάσταση του Quick 2FA."

#: includes/class-abilities.php:109
msgid "List users' security status"
msgstr "Εμφάνιση της κατάστασης ασφάλειας των χρηστών"

#: includes/class-abilities.php:110
msgid "Lists the security status of many users, such as administrators whose password is older than a year, or staff who have not logged in for 90 days. Without roles, lists users who can edit posts (staff), not customers or subscribers."
msgstr "Παρουσιάζει την κατάσταση ασφάλειας πολλών χρηστών, όπως διαχειριστές των οποίων ο κωδικός πρόσβασης έχει εκδοθεί πριν από περισσότερο από ένα χρόνο ή μέλη του προσωπικού που δεν έχουν συνδεθεί εδώ και 90 ημέρες. Χωρίς ρόλους, εμφανίζει τους χρήστες που μπορούν να επεξεργάζονται αναρτήσεις (μέλη του προσωπικού), όχι πελάτες ή συνδρομητές."

#: includes/class-abilities.php:118
msgid "Only users with one of these role slugs, such as administrator or shop_manager."
msgstr "Μόνο χρήστες με έναν από αυτούς τους κωδικούς ρόλου, όπως «administrator» ή «shop_manager»."

#: includes/class-abilities.php:123
msgid "Only users whose password is older than this many days. A password with no recorded change is aged from the user's registration."
msgstr "Μόνο χρήστες των οποίων ο κωδικός πρόσβασης έχει περάσει περισσότερες από τόσες ημέρες. Ο κωδικός πρόσβασης για τον οποίο δεν έχει καταγραφεί καμία αλλαγή υπολογίζεται από την ημερομηνία εγγραφής του χρήστη."

#: includes/class-abilities.php:128
msgid "Only users with no recorded login in this many days, including users with no recorded login at all."
msgstr "Μόνο χρήστες που δεν έχουν καταγραφεί να έχουν συνδεθεί εδώ και τόσες ημέρες, συμπεριλαμβανομένων των χρηστών που δεν έχουν καταγραφεί να έχουν συνδεθεί καθόλου."

#: includes/class-abilities.php:132
msgid "Only users whose account is locked."
msgstr "Μόνο χρήστες των οποίων ο λογαριασμός είναι κλειδωμένος."

#: includes/class-abilities.php:154
msgid "How many users matched, before limit and offset."
msgstr "Πόσοι χρήστες αντιστοιχίστηκαν, πριν από το όριο και την μετατόπιση."

#: includes/class-abilities.php:172
msgid "Get the two-factor authentication configuration"
msgstr "Λάβετε τις ρυθμίσεις για τον έλεγχο ταυτότητας δύο παραγόντων"

#: includes/class-abilities.php:173
msgid "Returns how Quick 2FA is configured: who must use two-factor authentication, how long verifications and trusted devices last, lockout duration and password reminder settings."
msgstr "Επιστρέφει πληροφορίες σχετικά με τον τρόπο διαμόρφωσης του Quick 2FA: ποιοι πρέπει να χρησιμοποιούν τον έλεγχο ταυτότητας δύο παραγόντων, πόσο διαρκούν οι επαληθεύσεις και οι αξιόπιστες συσκευές, τη διάρκεια του αποκλεισμού και τις ρυθμίσεις υπενθύμισης κωδικού πρόσβασης."

#: includes/class-abilities.php:185
msgid "Get a user's security events"
msgstr "Λήψη συμβάντων ασφαλείας ενός χρήστη"

#: includes/class-abilities.php:186
msgid "Returns a user's recent security events, newest first: verification codes sent, failed and successful verifications, account locks, password changes and trusted-device revocations. IP addresses and browser details are never returned."
msgstr "Επιστρέφει τα πρόσφατα συμβάντα ασφαλείας ενός χρήστη, με τα πιο πρόσφατα πρώτα: κωδικοί επαλήθευσης που έχουν αποσταλεί, αποτυχημένες και επιτυχημένες επαληθεύσεις, κλειδώματα λογαριασμού, αλλαγές κωδικού πρόσβασης και ανακλήσεις αξιόπιστων συσκευών. Οι διευθύνσεις IP και οι λεπτομέρειες του προγράμματος περιήγησης δεν επιστρέφονται ποτέ."

#: includes/class-abilities.php:204
msgid "Only events of these types."
msgstr "Μόνο γεγονότα αυτού του είδους."

#: includes/class-abilities.php:239
msgid "You are not allowed to query Quick 2FA."
msgstr "Δεν επιτρέπεται η υποβολή ερωτημάτων στο Quick 2FA."

#: includes/class-abilities.php:241
msgid "Complete two-factor verification before querying Quick 2FA."
msgstr "Ολοκληρώστε την επαλήθευση δύο παραγόντων πριν υποβάλετε αίτημα στο Quick 2FA."

#. translators: %d: the maximum number of users one query may cover
#: includes/class-abilities.php:309
#, php-format
msgid "More than %d users match. Narrow the query with roles."
msgstr "Υπάρχουν περισσότεροι από %d χρήστες που ανταποκρίνονται στα κριτήρια. Περιορίστε την αναζήτηση χρησιμοποιώντας ρόλους."

#: includes/class-abilities.php:586
msgid "No user matches that ID, login name or email address."
msgstr "Δεν υπάρχει χρήστης με αυτό το αναγνωριστικό, όνομα σύνδεσης ή διεύθυνση ηλεκτρονικού ταχυδρομείου."

#: includes/class-abilities.php:663
msgid "Whether this user must pass two-factor verification to reach the admin area."
msgstr "Αν ο χρήστης αυτός πρέπει να περάσει τον έλεγχο ταυτότητας δύο παραγόντων για να αποκτήσει πρόσβαση στην περιοχή διαχείρισης."

#: includes/class-abilities.php:667
msgid "When the password was last changed, or null if no change has been recorded since Quick 2FA was installed."
msgstr "Πότε άλλαξε για τελευταία φορά ο κωδικός πρόσβασης, ή «null» εάν δεν έχει καταγραφεί καμία αλλαγή από την εγκατάσταση του Quick 2FA."

#: includes/class-abilities.php:671
msgid "Days since the last recorded change, or since registration if none is recorded."
msgstr "Ημέρες από την τελευταία καταγεγραμμένη αλλαγή ή από την εγγραφή, εάν δεν έχει καταγραφεί καμία."

#: includes/class-abilities.php:676
msgid "The last recorded login, or null if none has been recorded; see last_login_recorded_since in the configuration."
msgstr "Η τελευταία καταγεγραμμένη σύνδεση ή η τιμή null αν δεν έχει καταγραφεί καμία· βλ. την παράμετρο last_login_recorded_since στη διαμόρφωση."

#: includes/class-abilities.php:682
msgid "Whether the lock lasts until an administrator removes it."
msgstr "Το αν η κλειδαριά θα παραμείνει ενεργή έως ότου την αφαιρέσει ένας διαχειριστής."

#: includes/class-abilities.php:704
msgid "Who must use two-factor authentication: every user, the protected roles only, or nobody."
msgstr "Ποιος πρέπει να χρησιμοποιεί τον έλεγχο ταυτότητας δύο παραγόντων: όλοι οι χρήστες, μόνο οι προστατευόμενοι ρόλοι ή κανείς."

#: includes/class-abilities.php:709
msgid "The roles that must use two-factor authentication when the mode is \"roles\"."
msgstr "Οι ρόλοι που πρέπει να χρησιμοποιούν έλεγχο ταυτότητας δύο παραγόντων όταν η λειτουργία είναι «ρόλοι»."

#: includes/class-abilities.php:722
msgid "When Quick 2FA began recording logins; earlier logins are unknown."
msgstr "Από τη στιγμή που το Quick 2FA άρχισε να καταγράφει τις συνδέσεις· οι προηγούμενες συνδέσεις δεν είναι γνωστές."

#: includes/class-abilities.php:754
msgid "Event context: source, reason, attempts, success, device_count, locked_until, actor_user_id. Only the fields the event recorded."
msgstr "Πλαίσιο συμβάντος: source, reason, attempts, success, device_count, locked_until, actor_user_id. Μόνο τα πεδία που καταγράφηκαν στο συμβάν."

#: includes/class-abilities.php:758
msgid "Reserved for non-identifying IP metadata such as country; always null in this version."
msgstr "Προορίζεται για μεταδεδομένα IP που δεν επιτρέπουν την ταυτοποίηση, όπως η χώρα· σε αυτή την έκδοση η τιμή είναι πάντα μηδενική."

#: views/settings-page.php:226
msgctxt "settings section heading; AI software assistants"
msgid "AI Agents"
msgstr "Πράκτορες τεχνητής νοημοσύνης"

#: views/settings-page.php:231
msgctxt "settings field label; the WordPress Abilities API feature"
msgid "Abilities API"
msgstr "Abilities API"

#: views/settings-page.php:234
msgid "Let AI agents query account security"
msgstr "Ας επιτρέψουμε στους πράκτορες τεχνητής νοημοσύνης να ελέγχουν την ασφάλεια των λογαριασμών"

#: views/settings-page.php:235
msgid "Lets an administrator's AI agent ask when users last changed their password, logged in or verified, whether accounts are locked, and for recent security events. Read-only: an agent can never lock, unlock or change anything through Quick 2FA. IP addresses and email addresses are never returned."
msgstr "Επιτρέπει στον πράκτορα τεχνητής νοημοσύνης ενός διαχειριστή να ρωτά πότε οι χρήστες άλλαξαν για τελευταία φορά τον κωδικό πρόσβασής τους, πότε συνδέθηκαν ή επαληθεύτηκαν, αν οι λογαριασμοί είναι κλειδωμένοι, καθώς και για πρόσφατα συμβάντα ασφαλείας. Μόνο για ανάγνωση: ένας πράκτορας δεν μπορεί ποτέ να κλειδώσει, να ξεκλειδώσει ή να αλλάξει οτιδήποτε μέσω του Quick 2FA. Οι διευθύνσεις IP και οι διευθύνσεις email δεν παρέχονται ποτέ."

#: views/settings-page.php:236
msgid "Needs WordPress 6.9 or later; this site's WordPress has no Abilities API."
msgstr "Απαιτείται WordPress 6.9 ή νεότερη έκδοση· το WordPress αυτού του ιστότοπου δεν διαθέτει το Abilities API."

#: includes/class-password-reminder-handler.php:151
msgid "That password is too long. Please choose a shorter one."
msgstr "Αυτός ο κωδικός πρόσβασης είναι πολύ μακρύς. Παρακαλώ, επιλέξτε έναν πιο σύντομο."

#. translators: %s: Username
#: includes/class-user-management.php:346
#, php-format
msgid "User %s could not be locked out, because the lock could not be saved. Their sessions have been ended. Please try again."
msgstr "Δεν ήταν δυνατή η αποκλεισμός του χρήστη %s, επειδή δεν ήταν δυνατή η αποθήκευση του αποκλεισμού. Οι συνεδρίες του έχουν τερματιστεί. Παρακαλώ δοκιμάστε ξανά."

#. translators: %s: Username
#: includes/class-user-management.php:410
#, php-format
msgid "User %s could not be unlocked, because the lock could not be removed. Please try again."
msgstr "Δεν ήταν δυνατή η απεμπλοκή του χρήστη %s, επειδή δεν ήταν δυνατή η κατάργηση του κλειδώματος. Παρακαλώ δοκιμάστε ξανά."

#: includes/class-account-security-handler.php:675
msgid "The trusted devices could not be removed. Please try again."
msgstr "Δεν ήταν δυνατή η κατάργηση των αξιόπιστων συσκευών. Παρακαλώ δοκιμάστε ξανά."

#. translators: %s: Username
#: includes/class-user-management.php:337
#, php-format
msgid "User %s has been locked out, but their sessions could not all be ended. Please try again."
msgstr "Ο χρήστης %s έχει αποκλειστεί, αλλά δεν ήταν δυνατό να τερματιστούν όλες οι συνεδρίες του. Παρακαλώ δοκιμάστε ξανά."

#. translators: %s: Username
#: includes/class-user-management.php:355
#, php-format
msgid "User %s could not be locked out, because the lock could not be saved, and their sessions could not all be ended. Please try again."
msgstr "Δεν ήταν δυνατή η απενεργοποίηση του χρήστη %s, επειδή δεν ήταν δυνατή η αποθήκευση του κλειδώματος και δεν ήταν δυνατό να τερματιστούν όλες οι συνεδρίες του. Παρακαλώ δοκιμάστε ξανά."

#: includes/class-user-management.php:664
msgid "The trusted device has been revoked."
msgstr "Η πιστοποιημένη συσκευή έχει ανακληθεί."

#: includes/class-user-management.php:666
msgid "The trusted device could not be revoked, or had already been removed. Check the list and try again."
msgstr "Η αξιόπιστη συσκευή δεν μπόρεσε να ανακληθεί ή είχε ήδη αφαιρεθεί. Ελέγξτε τη λίστα και δοκιμάστε ξανά."

#. translators: %d: number of trusted devices revoked
#: includes/class-user-management.php:711
#, php-format
msgid "%d trusted device has been revoked."
msgid_plural "%d trusted devices have been revoked."
msgstr[0] "Έχει ανακληθεί %d αξιόπιστη συσκευή."
msgstr[1] "Έχουν ανακληθεί %d αξιόπιστες συσκευές."
