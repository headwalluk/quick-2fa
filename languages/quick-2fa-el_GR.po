#: includes/class-user-management.php:351
#: includes/class-user-management.php:553
#: includes/class-user-management.php:599
msgid "You do not have permission to perform this action."
msgstr "Δεν έχετε άδεια να εκτελέσετε αυτήν την ενέργεια."

#: includes/class-user-management.php:299
msgid "You cannot lock out your own account."
msgstr "Δεν μπορείτε να κλειδώσετε τον δικό σας λογαριασμό."

#: includes/class-user-management.php:304
#: includes/class-user-management.php:356
#: includes/class-user-management.php:558
#: includes/class-user-management.php:604
msgid "Invalid user."
msgstr "Μη έγκυρος χρήστης."

#. translators: %s: Username
#: includes/class-user-management.php:326
#, php-format
msgid "User %s has been locked out."
msgstr "Ο χρήστης %s έχει αποκλειστεί."

#. translators: %s: Username
#: includes/class-user-management.php:376
#, php-format
msgid "User %s has been unlocked."
msgstr "Ο χρήστης %s έχει ξεκλειδωθεί."

#: includes/class-user-management.php:421
msgid "Locked out (manual)"
msgstr "Κλειδωμένο (χειροκίνητο)"

#. translators: %s: Formatted date and time
#: includes/class-user-management.php:432
#, php-format
msgid "Locked out until %s"
msgstr "Κλειδωμένο μέχρι %s"

#: includes/class-verification-code-handler.php:119
msgid "Too many verification codes requested. Please wait a few more seconds before requesting another code."
msgstr "Ζητήθηκαν πάρα πολλοί κωδικοί επαλήθευσης. Παρακαλώ περιμένετε μερικά δευτερόλεπτα πριν ζητήσετε έναν άλλο κωδικό."

#. translators: %d: number of minutes to wait
#: includes/class-verification-code-handler.php:126
#, php-format
msgid "Too many verification codes requested. Please wait %d minutes before requesting another code."
msgstr "Ζητήθηκαν πάρα πολλοί κωδικοί επαλήθευσης. Παρακαλώ περιμένετε %d λεπτά πριν ζητήσετε έναν άλλο κωδικό."

#: includes/class-verification-code-handler.php:188
msgid "User not found."
msgstr "Δεν βρέθηκε χρήστης."

#. translators: %d: number of minutes until unlock
#: includes/class-verification-code-handler.php:231
#, php-format
msgid "Your account has been temporarily locked due to too many failed attempts. Please try again in %d minutes."
msgstr "Ο λογαριασμός σας έχει κλειδωθεί προσωρινά λόγω υπερβολικού αριθμού αποτυχημένων προσπαθειών. Παρακαλώ δοκιμάστε ξανά σε %d λεπτά."

#: includes/class-verification-code-handler.php:240
msgid "No verification code found. Please request a new code."
msgstr "Δεν βρέθηκε κωδικός επαλήθευσης. Ζητήστε έναν νέο κωδικό."

#. translators: %d: number of minutes until expiry
#: includes/class-verification-code-handler.php:251
#, php-format
msgid "Your verification code has expired. Codes are valid for %d minutes. Please request a new code."
msgstr "Ο κωδικός επαλήθευσης έχει λήξει. Οι κωδικοί ισχύουν για %d λεπτά. Ζητήστε έναν νέο κωδικό."

#: includes/class-verification-code-handler.php:262
#: includes/class-verification-code-handler.php:290
msgid "Too many failed verification attempts. Your account has been temporarily locked for security."
msgstr "Πάρα πολλές αποτυχημένες προσπάθειες επαλήθευσης. Ο λογαριασμός σας έχει κλειδωθεί προσωρινά για λόγους ασφαλείας."

#. translators: %d: number of attempts remaining
#: includes/class-verification-code-handler.php:284
#, php-format
msgid "Invalid verification code. You have %d attempt remaining."
msgid_plural "Invalid verification code. You have %d attempts remaining."
msgstr[0] ""
msgstr[1] ""

#: views/password-page.php:30
msgid "Update Your Password"
msgstr "Ενημερώστε τον κωδικό πρόσβασής σας"

#. translators: %d: number of days since last password change
#: views/password-page.php:58
#, php-format
msgid "It's been %d days since you last changed your password. For your security, we recommend updating it regularly."
msgstr "Έχουν περάσει %d ημέρες από την τελευταία φορά που αλλάξατε τον κωδικό πρόσβασής σας. Για την ασφάλειά σας, σας συνιστούμε να τον ενημερώνετε τακτικά."

#: views/password-page.php:76
msgid "New Password:"
msgstr "Νέος κωδικός πρόσβασης:"

#: views/password-page.php:85
#: views/password-page.php:119
msgid "Show password"
msgstr "Εμφάνιση κωδικού πρόσβασης"

#: views/password-page.php:90
msgid "A strong password has been generated for you. You can use it as-is or change it to your own."
msgstr "Έχει δημιουργηθεί ένας ισχυρός κωδικός πρόσβασης για εσάς. Μπορείτε να τον χρησιμοποιήσετε ως έχει ή να τον αλλάξετε με δικό σας."

#: views/password-page.php:95
msgid "Update Password"
msgstr "Ενημέρωση κωδικού πρόσβασης"

