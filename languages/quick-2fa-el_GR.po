#. Plugin Name of the plugin
#: quick-2fa.php
#: includes/class-settings.php:38
msgid "Quick 2FA"
msgstr "Γρήγορη 2FA"

#. Plugin URI of the plugin
#: quick-2fa.php
msgid "https://github.com/create-element/quick-2fa"
msgstr "https://github.com/create-element/quick-2fa"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Ελαφριά επαλήθευση δύο παραγόντων μέσω email για πρόσβαση διαχειριστή WordPress."

#. Author of the plugin
#: quick-2fa.php
msgid "Paul Faulkner"
msgstr "Πολ Φόλκνερ"

#. Author URI of the plugin
#: quick-2fa.php
msgid "https://power-plugins.com"
msgstr "https://power-plugins.com"

#. translators: %s: User display name
#: emails/verification-code.php:20
#, php-format
msgid "Hi %s,"
msgstr "Γεια σου %s,"

#. translators: %s: Verification code
#: emails/verification-code.php:27
#, php-format
msgid "Your verification code is: %s"
msgstr "Ο κωδικός επαλήθευσης είναι: %s"

#. translators: %d: Number of minutes
#: emails/verification-code.php:34
#, php-format
msgid "This code will expire in %d minutes."
msgstr "Αυτός ο κωδικός θα λήξει σε %d λεπτά."

#: emails/verification-code.php:39
msgid "If you did not request this code, please contact your site administrator immediately."
msgstr "Εάν δεν ζητήσατε αυτόν τον κωδικό, επικοινωνήστε αμέσως με τον διαχειριστή του ιστότοπού σας."

#: functions.php:47
#: includes/class-email-handler.php:38
#: includes/class-settings.php:352
msgid "Your verification code"
msgstr "Ο κωδικός επαλήθευσης"

#: functions.php:90
#: views/verification-page.php:59
msgid "For your security, we need to verify your identity before you can access the admin area."
msgstr "Για την ασφάλειά σας, πρέπει να επαληθεύσουμε την ταυτότητά σας προτού αποκτήσετε πρόσβαση στην περιοχή διαχείρισης."

#: functions.php:100
msgid "Regular password changes help keep your account secure. We recommend updating your password every 60 days."
msgstr "Η τακτική αλλαγή κωδικού πρόσβασης συμβάλλει στην ασφάλεια του λογαριασμού σας. Σας συνιστούμε να ενημερώνετε τον κωδικό πρόσβασής σας κάθε 60 ημέρες."

#: includes/class-email-handler.php:45
msgid "Failed to send verification email. Please contact your site administrator."
msgstr "Αποτυχία αποστολής email επαλήθευσης. Επικοινωνήστε με τον διαχειριστή του ιστότοπου."

#: includes/class-password-reminder-handler.php:141
msgid "Please enter a password."
msgstr "Παρακαλώ εισάγετε έναν κωδικό πρόσβασης."

#: includes/class-password-reminder-handler.php:145
msgid "Password must be at least 8 characters long."
msgstr "Ο κωδικός πρόσβασης πρέπει να έχει μήκος τουλάχιστον 8 χαρακτήρες."

#: includes/class-plugin.php:138
#: includes/class-plugin.php:173
msgid "Your account has been locked. Please contact your site administrator."
msgstr "Ο λογαριασμός σας έχει κλειδωθεί. Παρακαλώ επικοινωνήστε με τον διαχειριστή του ιστότοπου."

#. translators: %s: Time remaining until unlock
#: includes/class-plugin.php:142
#: includes/class-plugin.php:177
#, php-format
msgid "Your account has been locked. Please try again in %s."
msgstr "Ο λογαριασμός σας έχει κλειδωθεί. Παρακαλώ δοκιμάστε ξανά σε %s."

#: includes/class-plugin.php:182
msgid "Account Locked"
msgstr "Λογαριασμός κλειδωμένος"

#: includes/class-plugin.php:395
msgid "Invalid action"
msgstr "Μη έγκυρη ενέργεια"

#: includes/class-plugin.php:395
msgid "Error"
msgstr "Σφάλμα"

#: includes/class-plugin.php:417
#: includes/class-plugin.php:459
#: includes/class-plugin.php:503
#: includes/class-plugin.php:519
msgid "Security check failed. Please try again."
msgstr "Ο έλεγχος ασφαλείας απέτυχε. Παρακαλώ δοκιμάστε ξανά."

#: includes/class-plugin.php:422
msgid "Please enter the verification code."
msgstr "Παρακαλώ εισάγετε τον κωδικό επαλήθευσης."

#: includes/class-plugin.php:466
msgid "A new verification code has been sent to your email."
msgstr "Ένας νέος κωδικός επαλήθευσης έχει σταλεί στο email σας."

#: includes/class-plugin.php:550
msgid "Quick 2FA is currently disabled."
msgstr "Η γρήγορη 2FA είναι προς το παρόν απενεργοποιημένη."

#: includes/class-plugin.php:551
msgid "Your admin area is not protected by two-factor authentication."
msgstr "Η περιοχή διαχείρισης δεν προστατεύεται από έλεγχο ταυτότητας δύο παραγόντων."

#: includes/class-plugin.php:553
msgid "Enable 2FA"
msgstr "Ενεργοποίηση 2FA"

#: includes/class-settings.php:38
msgid "Quick 2FA Settings"
msgstr "Γρήγορες ρυθμίσεις 2FA"

#: includes/class-settings.php:328
msgid "Select roles..."
msgstr "Επιλέξτε ρόλους..."

#: includes/class-user-management.php:72
msgid "Lock Status"
msgstr "Κατάσταση κλειδώματος"

#: includes/class-user-management.php:103
