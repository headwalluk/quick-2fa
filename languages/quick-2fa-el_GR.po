#, php-format
msgid "You have %d trusted device."
msgid_plural "You have %d trusted devices."
msgstr[0] "Έχετε %d αξιόπιστη συσκευή."
msgstr[1] "Έχετε %d αξιόπιστες συσκευές."

#: views/profile-trusted-devices.php:30
msgctxt "table column header"
msgid "Device"
msgstr "Συσκευή"

#: views/profile-trusted-devices.php:31
msgctxt "table column header; when device trust expires"
msgid "Expires"
msgstr "Λήξη"

#: views/profile-trusted-devices.php:32
msgctxt "table column header"
msgid "Actions"
msgstr "Ενέργειες"

#. translators: %d: device number
#: views/profile-trusted-devices.php:53
#, php-format
msgid "Device #%d"
msgstr "Συσκευή #%d"

#: views/profile-trusted-devices.php:55
msgid "This Device"
msgstr "Αυτή η συσκευή"

#. translators: %d: number of days until expiry
#: views/profile-trusted-devices.php:63
#, php-format
msgid "In %d day"
msgid_plural "In %d days"
msgstr[0] "Σε %d ημέρα"
msgstr[1] "Σε %d ημέρες"

#: views/profile-trusted-devices.php:66
msgctxt "device trust expires today"
msgid "Today"
msgstr "Σήμερα"

#: views/profile-trusted-devices.php:74
msgctxt "verb; button to revoke a trusted device"
msgid "Revoke"
msgstr "Ανάκληση"

#: views/profile-trusted-devices.php:97
msgid "Revoke All Devices"
msgstr "Ανάκληση όλων των συσκευών"

#: views/profile-trusted-devices.php:103
msgid "Revoking devices will require re-verification from those devices on the next login."
msgstr "Η ανάκληση συσκευών θα απαιτήσει εκ νέου επαλήθευση από τις συγκεκριμένες συσκευές κατά την επόμενη σύνδεση."

#: views/settings-page.php:58
#: views/settings-page.php:59
msgid "2FA Mode"
msgstr "Λειτουργία 2FA"

#: views/settings-page.php:66
msgctxt "2FA mode option label"
msgid "Disabled"
msgstr "Απενεργοποιημένη"

#: views/settings-page.php:67
msgid "Two-factor authentication is disabled. Not recommended for production sites."
msgstr "Η επαλήθευση δύο παραγόντων είναι απενεργοποιημένη. Δεν συνιστάται για ιστότοπους παραγωγής."

#: views/settings-page.php:75
msgid "Enabled for all users"
msgstr "Ενεργοποιημένο για όλους τους χρήστες"

#: views/settings-page.php:76
msgid "All users, including subscribers, will be required to verify their identity."
msgstr "Όλοι οι χρήστες, συμπεριλαμβανομένων των συνδρομητών, θα πρέπει να επαληθεύσουν την ταυτότητά τους."

#: views/settings-page.php:84
msgid "Enabled for specific roles"
msgstr "Ενεργοποιημένο για συγκεκριμένους ρόλους"

#: views/settings-page.php:85
msgid "Only users with selected roles will be required to verify their identity."
msgstr "Μόνο οι χρήστες με συγκεκριμένους ρόλους θα υποχρεούνται να επαληθεύσουν την ταυτότητά τους."

#: views/settings-page.php:93
msgid "Protected Roles"
msgstr "Προστατευμένοι ρόλοι"

#: views/settings-page.php:112
msgid "Select which user roles require two-factor authentication."
msgstr "Επιλέξτε τους ρόλους χρηστών για τους οποίους απαιτείται έλεγχος ταυτότητας δύο παραγόντων."

#: views/settings-page.php:117
msgid "Verification Period"
msgstr "Περίοδος επαλήθευσης"

#: views/settings-page.php:120
#: views/settings-page.php:147
#: views/settings-page.php:210
#: views/settings-page.php:219
msgctxt "unit suffix after a number input"
msgid "days"
msgstr "ημέρες"

#: views/settings-page.php:126
msgid "Code Length"
msgstr "Μήκος κώδικα"

#: views/settings-page.php:129
msgctxt "unit suffix after a number input"
msgid "digits"
msgstr "ψηφία"

#: views/settings-page.php:130
msgid "Length of the verification code (4-8 digits)."
msgstr "Μήκος του κωδικού επαλήθευσης (4-8 ψηφία)."

#: views/settings-page.php:135
msgid "Code Expiry"
msgstr "Λήξη κωδικού"

#: views/settings-page.php:138
#: views/settings-page.php:156
msgctxt "unit suffix after a number input"
msgid "minutes"
msgstr "λεπτά"

#: views/settings-page.php:139
msgid "How long verification codes remain valid (5-60 minutes)."
msgstr "Πόσο καιρό παραμένουν σε ισχύ οι κωδικοί επαλήθευσης (5-60 λεπτά)."

#: views/settings-page.php:144
msgid "Trust Device Duration"
msgstr "Διάρκεια ισχύος της συσκευής εμπιστοσύνης"

#: views/settings-page.php:148
msgid "How long a trusted device remains trusted before requiring 2FA again (1-365 days)."
msgstr "Πόσο καιρό μια αξιόπιστη συσκευή παραμένει αξιόπιστη πριν απαιτηθεί εκ νέου η χρήση της διπλής επαλήθευσης (2FA) (1–365 ημέρες)."

#: views/settings-page.php:153
msgid "Auto-Lock Duration"
msgstr "Διάρκεια αυτόματου κλειδώματος"

#: views/settings-page.php:157
msgid "Duration to lock accounts after too many failed verification attempts (1-1440 minutes = 1 minute to 24 hours)."
msgstr "Χρονικό διάστημα κατά το οποίο οι λογαριασμοί θα παραμείνουν κλειδωμένοι μετά από υπερβολικά πολλές αποτυχημένες προσπάθειες επαλήθευσης (1-1440 λεπτά = 1 λεπτό έως 24 ώρες)."

#: views/settings-page.php:163
msgid "Email Settings"
msgstr "Ρυθμίσεις ηλεκτρονικού ταχυδρομείου"

#: views/settings-page.php:168
msgid "From Name"
msgstr "Από Όνομα"

#: views/settings-page.php:171
msgid "The name that appears in the \"From\" field of verification emails."
msgstr "Το όνομα που εμφανίζεται στο πεδίο «Από» των μηνυμάτων ηλεκτρονικού ταχυδρομείου επαλήθευσης."

#: views/settings-page.php:176
msgid "From Address"
msgstr "Από τη διεύθυνση"

#: views/settings-page.php:179
msgid "The email address that appears in the \"From\" field of verification emails."
msgstr "Η διεύθυνση ηλεκτρονικού ταχυδρομείου που εμφανίζεται στο πεδίο «Από» των μηνυμάτων επαλήθευσης."

#: views/settings-page.php:184
msgid "Email Subject"
msgstr "Θέμα email"

#: views/settings-page.php:187
msgid "Subject line for verification emails."
msgstr "Θέμα για τα μηνύματα ηλεκτρονικού ταχυδρομείου επαλήθευσης."

#: views/settings-page.php:193
msgid "Password Reminder Settings"
msgstr "Ρυθμίσεις υπενθύμισης κωδικού πρόσβασης"

#: views/settings-page.php:198
msgid "Password Reminders"
msgstr "Υπενθυμίσεις κωδικού πρόσβασης"

#: views/settings-page.php:201
msgid "Enable password change reminders"
msgstr "Ενεργοποίηση υπενθυμίσεων αλλαγής κωδικού πρόσβασης"

#: views/settings-page.php:202
msgid "Periodically remind users to update their passwords."
msgstr "Υπενθυμίζετε περιοδικά στους χρήστες να ενημερώνουν τους κωδικούς πρόσβασής τους."

#: views/settings-page.php:207
msgid "Reminder Period"
msgstr "Περίοδος υπενθύμισης"

#: views/settings-page.php:211
msgid "Remind users to change their password after this many days (30-365 days)."
msgstr "Υπενθυμίστε στους χρήστες να αλλάξουν τον κωδικό πρόσβασής τους μετά από τόσες ημέρες (30-365 ημέρες)."

#: views/settings-page.php:216
msgid "Reminder Cooldown"
msgstr "Χρόνος αναμονής υπενθύμισης"

#: views/settings-page.php:220
msgid "Wait this many days before showing the reminder again if dismissed (1-90 days)."
msgstr "Περίμενε τόσες ημέρες πριν εμφανιστεί ξανά η υπενθύμιση, αν έχει απορριφθεί (1-90 ημέρες)."

#: views/verification-page.php:31
#: views/verification-page.php:60
msgid "Account Verification Required"
msgstr "Απαιτείται επαλήθευση λογαριασμού"

#: views/verification-page.php:63
msgid "Please enter the verification code sent to your email."
msgstr "Παρακαλώ εισάγετε τον κωδικό επαλήθευσης που σας έχει σταλεί στο email σας."

#: views/verification-page.php:69
msgid "Verification Code:"
msgstr "Κωδικός επαλήθευσης:"

#. translators: %d: number of days
#: views/verification-page.php:80
#, php-format
msgid "Trust this device for %d day"
msgid_plural "Trust this device for %d days"
msgstr[0] "Εμπιστευθείτε αυτή τη συσκευή για %d ημέρα"
msgstr[1] "Εμπιστευθείτε αυτή τη συσκευή για %d ημέρες"

#: views/verification-page.php:87
msgctxt "verb; submit button label"
msgid "Verify"
msgstr "Επαλήθευση"

#: views/verification-page.php:96
msgid "Resend Code"
msgstr "Επανάληψη αποστολής κωδικού"

#. translators: %d: Number of minutes
#: emails/verification-code.php:34
#, php-format
msgid "This code will expire in %d minute."
msgid_plural "This code will expire in %d minutes."
msgstr[0] "Αυτός ο κωδικός θα λήξει σε %d λεπτό."
msgstr[1] "Αυτός ο κωδικός θα λήξει σε %d λεπτά."

#. translators: %d: minimum number of characters required in a password
#: includes/class-password-reminder-handler.php:141
#, php-format
msgid "Password must be at least %d character long."
msgid_plural "Password must be at least %d characters long."
msgstr[0] "Ο κωδικός πρόσβασης πρέπει να έχει μήκος τουλάχιστον %d χαρακτήρες."
msgstr[1] "Ο κωδικός πρόσβασης πρέπει να έχει μήκος τουλάχιστον %d χαρακτήρες."

#: includes/class-plugin.php:608
#: includes/class-plugin.php:691
msgid "Your user account could not be loaded. Please sign in again."
msgstr "Δεν ήταν δυνατή η φόρτωση του λογαριασμού χρήστη σας. Παρακαλώ, συνδεθείτε ξανά."

#. translators: %d: number of minutes to wait
#: includes/class-verification-code-handler.php:123
#, php-format
msgid "Too many verification codes requested. Please wait %d minute before requesting another code."
msgid_plural "Too many verification codes requested. Please wait %d minutes before requesting another code."
msgstr[0] "Ζητήθηκαν πάρα πολλοί κωδικοί επαλήθευσης. Παρακαλώ περιμένετε %d λεπτό πριν ζητήσετε έναν άλλο κωδικό."
msgstr[1] "Ζητήθηκαν πάρα πολλοί κωδικοί επαλήθευσης. Παρακαλώ περιμένετε %d λεπτά πριν ζητήσετε έναν άλλο κωδικό."

#. translators: %d: number of minutes until unlock
#: includes/class-verification-code-handler.php:283
#, php-format
msgid "Your account has been temporarily locked due to too many failed attempts. Please try again in %d minute."
msgid_plural "Your account has been temporarily locked due to too many failed attempts. Please try again in %d minutes."
msgstr[0] "Ο λογαριασμός σας έχει κλειδωθεί προσωρινά λόγω υπερβολικού αριθμού αποτυχημένων προσπαθειών. Παρακαλώ δοκιμάστε ξανά σε %d λεπτό."
msgstr[1] "Ο λογαριασμός σας έχει κλειδωθεί προσωρινά λόγω υπερβολικού αριθμού αποτυχημένων προσπαθειών. Παρακαλώ δοκιμάστε ξανά σε %d λεπτά."

#. translators: %d: number of minutes until expiry
#: includes/class-verification-code-handler.php:309
#, php-format
msgid "Your verification code has expired. Codes are valid for %d minute. Please request a new code."
msgid_plural "Your verification code has expired. Codes are valid for %d minutes. Please request a new code."
msgstr[0] "Ο κωδικός επαλήθευσής σας έχει λήξει. Οι κωδικοί ισχύουν για %d λεπτό. Παρακαλώ ζητήστε έναν νέο κωδικό."
msgstr[1] "Ο κωδικός επαλήθευσής σας έχει λήξει. Οι κωδικοί ισχύουν για %d λεπτά. Παρακαλώ ζητήστε έναν νέο κωδικό."

#. translators: %d: number of days since last password change
#: views/password-page.php:59
#, php-format
msgid "It's been %d day since you last changed your password. For your security, we recommend updating it regularly."
msgid_plural "It's been %d days since you last changed your password. For your security, we recommend updating it regularly."
msgstr[0] "Έχουν περάσει %d ημέρες από την τελευταία αλλαγή του κωδικού πρόσβασής σας. Για την ασφάλειά σας, σας συνιστούμε να τον ανανεώνετε τακτικά."
msgstr[1] "Έχουν περάσει %d ημέρες από την τελευταία αλλαγή του κωδικού πρόσβασής σας. Για τη δική σας ασφάλεια, σας συνιστούμε να τον ενημερώνετε τακτικά."

#: views/settings-page.php:121
msgid "How long a verification trusts the device when \"Trust this device\" is left unticked (1-365 days). Not used when trusted devices are disabled."
msgstr "Για πόσο χρονικό διάστημα η επαλήθευση θεωρεί αξιόπιστη τη συσκευή όταν το πλαίσιο «Εμπιστευθείτε αυτή τη συσκευή» δεν είναι επιλεγμένο (1–365 ημέρες). Δεν χρησιμοποιείται όταν οι αξιόπιστες συσκευές είναι απενεργοποιημένες."

#. translators: %d: number of days between password changes, from the Reminder Period setting
#: functions-private.php:157
#, php-format
msgid "Regular password changes help keep your account secure. We recommend updating your password every %d day."
msgid_plural "Regular password changes help keep your account secure. We recommend updating your password every %d days."
msgstr[0] "Η τακτική αλλαγή του κωδικού πρόσβασης συμβάλλει στη διατήρηση της ασφάλειας του λογαριασμού σας. Σας συνιστούμε να ενημερώνετε τον κωδικό πρόσβασής σας κάθε %d ημέρα."
msgstr[1] "Η τακτική αλλαγή του κωδικού πρόσβασης συμβάλλει στη διατήρηση της ασφάλειας του λογαριασμού σας. Σας συνιστούμε να ενημερώνετε τον κωδικό πρόσβασής σας κάθε %d ημέρες."

#: views/settings-page.php:242
msgctxt "settings section heading"
msgid "Uninstall"
msgstr "Απεγκατάσταση"

#: views/settings-page.php:247
msgid "Plugin Data"
msgstr "Πρόσθετο δεδομένων"

#: views/settings-page.php:250
msgid "Delete all plugin data when uninstalled"
msgstr "Διαγραφή όλων των δεδομένων του πρόσθετου κατά την απεγκατάσταση"

#: views/settings-page.php:251
msgid "When the plugin is deleted from the Plugins screen, also delete its settings, account locks, trusted devices, event logs and last-login records. Deactivating the plugin never deletes anything."
msgstr "Όταν το πρόσθετο διαγράφεται από την οθόνη «Πρόσθετα», διαγράψτε επίσης τις ρυθμίσεις του, τους αποκλεισμούς λογαριασμών, τις αξιόπιστες συσκευές, τα αρχεία καταγραφής συμβάντων και τα αρχεία καταγραφής τελευταίας σύνδεσης. Η απενεργοποίηση του πρόσθετου δεν διαγράφει ποτέ τίποτα."

