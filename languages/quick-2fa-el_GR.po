#. Plugin Name of the plugin
#: quick-2fa.php
#: includes/class-settings.php:38
msgid "Quick 2FA"
msgstr "Γρήγορη 2FA"

#. Plugin URI of the plugin
#: quick-2fa.php
msgid "https://github.com/headwalluk/quick-2fa"
msgstr "https://github.com/headwalluk/quick-2fa"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Ελαφρύς έλεγχος ταυτότητας δύο παραγόντων μέσω email για την πρόσβαση στη διαχείριση του WordPress."

#. Author of the plugin
#: quick-2fa.php
msgid "Paul Faulkner"
msgstr "Πολ Φόλκνερ"

#. translators: %s: User display name
#: emails/verification-code.php:20
#, php-format
msgid "Hi %s,"
msgstr "Γεια σου %s,"

#. translators: %s: Verification code
#: emails/verification-code.php:27
#, php-format
msgid "Your verification code is: %s"
msgstr "Ο κωδικός επαλήθευσης είναι: %s"

#. translators: %d: Number of minutes
#: emails/verification-code.php:34
#, php-format
msgid "This code will expire in %d minutes."
msgstr "Ο κωδικός αυτός θα λήξει σε %d λεπτά."

#: emails/verification-code.php:39
msgid "If you did not request this code, please contact your site administrator immediately."
msgstr "Εάν δεν ζητήσατε εσείς αυτόν τον κωδικό, παρακαλούμε επικοινωνήστε αμέσως με τον διαχειριστή του ιστότοπου."

#: functions-private.php:44
#: includes/class-email-handler.php:38
#: includes/class-settings.php:352
msgid "Your verification code"
msgstr "Ο κωδικός επαλήθευσης"

#: functions-private.php:124
msgid "For your security, we need to verify your identity before you can access the admin area."
msgstr "Για λόγους ασφαλείας, πρέπει να επαληθεύσουμε την ταυτότητά σας προτού μπορέσετε να αποκτήσετε πρόσβαση στον πίνακα διαχείρισης."

#: functions-private.php:153
msgid "Regular password changes help keep your account secure. We recommend updating your password every 60 days."
msgstr "Η τακτική αλλαγή του κωδικού πρόσβασης συμβάλλει στη διατήρηση της ασφάλειας του λογαριασμού σας. Σας συνιστούμε να αλλάζετε τον κωδικό πρόσβασής σας κάθε 60 ημέρες."

#: includes/class-email-handler.php:45
msgid "Failed to send verification email. Please contact your site administrator."
msgstr "Δεν κατέστη δυνατή η αποστολή του email επαλήθευσης. Παρακαλώ επικοινωνήστε με τον διαχειριστή του ιστότοπου."

#: includes/class-password-reminder-handler.php:141
msgid "Please enter a password."
msgstr "Παρακαλώ εισάγετε έναν κωδικό πρόσβασης."

#: includes/class-password-reminder-handler.php:145
msgid "Password must be at least 8 characters long."
msgstr "Ο κωδικός πρόσβασης πρέπει να έχει μήκος τουλάχιστον 8 χαρακτήρες."

#: includes/class-plugin.php:165
#: includes/class-plugin.php:200
msgid "Your account has been locked. Please contact your site administrator."
msgstr "Ο λογαριασμός σας έχει κλειδωθεί. Παρακαλώ επικοινωνήστε με τον διαχειριστή του ιστότοπου."

#. translators: %s: Time remaining until unlock
#: includes/class-plugin.php:169
#: includes/class-plugin.php:204
#, php-format
msgid "Your account has been locked. Please try again in %s."
msgstr "Ο λογαριασμός σας έχει κλειδωθεί. Παρακαλώ δοκιμάστε ξανά σε %s."

#: includes/class-plugin.php:209
msgid "Account Locked"
msgstr "Ο λογαριασμός έχει κλειδωθεί"

#: includes/class-plugin.php:423
msgid "Invalid action"
msgstr "Μη έγκυρη ενέργεια"

#: includes/class-plugin.php:423
msgid "Error"
msgstr "Σφάλμα"

#: includes/class-plugin.php:445
#: includes/class-plugin.php:487
#: includes/class-plugin.php:533
#: includes/class-plugin.php:549
msgid "Security check failed. Please try again."
msgstr "Ο έλεγχος ασφαλείας απέτυχε. Παρακαλώ δοκιμάστε ξανά."

#: includes/class-plugin.php:450
msgid "Please enter the verification code."
msgstr "Παρακαλώ εισάγετε τον κωδικό επαλήθευσης."

#: includes/class-plugin.php:494
msgid "A new verification code has been sent to your email."
msgstr "Ένας νέος κωδικός επαλήθευσης έχει σταλεί στο email σας."

#: includes/class-plugin.php:580
msgid "Quick 2FA is currently disabled."
msgstr "Η λειτουργία «Γρήγορη 2FA» είναι προς το παρόν απενεργοποιημένη."

#: includes/class-plugin.php:581
msgid "Your admin area is not protected by two-factor authentication."
msgstr "Ο πίνακας ελέγχου σας δεν προστατεύεται από έλεγχο ταυτότητας δύο παραγόντων."

#: includes/class-plugin.php:583
msgid "Enable 2FA"
msgstr "Ενεργοποίηση 2FA"

#: includes/class-settings.php:38
msgid "Quick 2FA Settings"
msgstr "Γρήγορες ρυθμίσεις 2FA"

#: includes/class-settings.php:328
msgid "Select roles..."
msgstr "Επιλέξτε ρόλους..."

#: includes/class-user-management.php:72
msgid "Lock Status"
msgstr "Κατάσταση κλειδώματος"

#: includes/class-user-management.php:101
msgid "Not locked out"
msgstr "Δεν έχει κλειδωθεί έξω"

#: includes/class-user-management.php:159
msgid "Locked Out"
msgstr "Κλειδωμένος έξω"

#: includes/class-user-management.php:171
msgid "Not Locked Out"
msgstr "Δεν έχει κλειδωθεί έξω"

#: includes/class-user-management.php:261
msgid "Unlock"
msgstr "Ξεκλείδωμα"

#: includes/class-user-management.php:273
msgid "Lock Out"
msgstr "Αποκλεισμός"

#: includes/class-user-management.php:289
#: includes/class-user-management.php:345
#: includes/class-user-management.php:546
#: includes/class-user-management.php:592
msgid "Security check failed."
msgstr "Ο έλεγχος ασφαλείας απέτυχε."

#: includes/class-user-management.php:293
#: includes/class-user-management.php:349
#: includes/class-user-management.php:550
#: includes/class-user-management.php:596
msgid "You do not have permission to perform this action."
msgstr "Δεν έχετε δικαιώματα για να εκτελέσετε αυτήν την ενέργεια."

#: includes/class-user-management.php:297
msgid "You cannot lock out your own account."
msgstr "Δεν μπορείτε να κλειδώσετε τον δικό σας λογαριασμό."

#: includes/class-user-management.php:302
#: includes/class-user-management.php:354
#: includes/class-user-management.php:555
#: includes/class-user-management.php:601
msgid "Invalid user."
msgstr "Μη έγκυρος χρήστης."

#. translators: %s: Username
#: includes/class-user-management.php:324
#, php-format
msgid "User %s has been locked out."
msgstr "Ο χρήστης %s έχει αποκλειστεί."

#. translators: %s: Username
#: includes/class-user-management.php:374
#, php-format
msgid "User %s has been unlocked."
msgstr "Ο χρήστης %s έχει αποκτήσει πρόσβαση."

#: includes/class-user-management.php:418
msgid "Locked out (manual)"
msgstr "Κλειδωμένο (χειροκίνητα)"

#. translators: %s: Formatted date and time
#: includes/class-user-management.php:429
#, php-format
msgid "Locked out until %s"
msgstr "Κλειδωμένο μέχρι τις %s"

#: includes/class-verification-code-handler.php:109
msgid "Too many verification codes requested. Please wait a few more seconds before requesting another code."
msgstr "Ζητήθηκαν πάρα πολλοί κωδικοί επαλήθευσης. Παρακαλώ περιμένετε μερικά δευτερόλεπτα πριν ζητήσετε έναν άλλο κωδικό."

#. translators: %d: number of minutes to wait
#: includes/class-verification-code-handler.php:115
#, php-format
msgid "Too many verification codes requested. Please wait %d minutes before requesting another code."
msgstr "Ζητήθηκαν πάρα πολλοί κωδικοί επαλήθευσης. Παρακαλώ περιμένετε %d λεπτά πριν ζητήσετε έναν άλλο κωδικό."

#: includes/class-verification-code-handler.php:179
msgid "User not found."
msgstr "Ο χρήστης δεν βρέθηκε."

#. translators: %d: number of minutes until unlock
#: includes/class-verification-code-handler.php:223
#, php-format
msgid "Your account has been temporarily locked due to too many failed attempts. Please try again in %d minutes."
msgstr "Ο λογαριασμός σας έχει κλειδωθεί προσωρινά λόγω υπερβολικού αριθμού αποτυχημένων προσπαθειών. Παρακαλώ δοκιμάστε ξανά σε %d λεπτά."

#: includes/class-verification-code-handler.php:232
msgid "No verification code found. Please request a new code."
msgstr "Δεν βρέθηκε κωδικός επαλήθευσης. Ζητήστε έναν νέο κωδικό."

#. translators: %d: number of minutes until expiry
#: includes/class-verification-code-handler.php:243
#, php-format
msgid "Your verification code has expired. Codes are valid for %d minutes. Please request a new code."
msgstr "Ο κωδικός επαλήθευσης έχει λήξει. Οι κωδικοί ισχύουν για %d λεπτά. Ζητήστε έναν νέο κωδικό."

#: includes/class-verification-code-handler.php:254
#: includes/class-verification-code-handler.php:285
msgid "Too many failed verification attempts. Your account has been temporarily locked for security."
msgstr "Πάρα πολλές αποτυχημένες προσπάθειες επαλήθευσης. Ο λογαριασμός σας έχει κλειδωθεί προσωρινά για λόγους ασφαλείας."

#. translators: %d: number of attempts remaining
#: includes/class-verification-code-handler.php:279
#, php-format
msgid "Invalid verification code. You have %d attempt remaining."
msgid_plural "Invalid verification code. You have %d attempts remaining."
msgstr[0] ""
msgstr[1] ""

#: views/password-page.php:31
msgid "Update Your Password"
msgstr "Ενημέρωση του κωδικού πρόσβασής σας"

#: views/password-page.php:55
msgid "It's been over a year since you last changed your password. For your security, we recommend updating it regularly."
msgstr "Έχει περάσει πάνω από ένας χρόνος από την τελευταία φορά που αλλάξατε τον κωδικό πρόσβασής σας. Για λόγους ασφαλείας, σας συνιστούμε να τον ανανεώνετε τακτικά."

#. translators: %d: number of days since last password change
#: views/password-page.php:59
#, php-format
msgid "It's been %d days since you last changed your password. For your security, we recommend updating it regularly."
msgstr "Έχουν περάσει %d ημέρες από την τελευταία φορά που αλλάξατε τον κωδικό πρόσβασής σας. Για λόγους ασφαλείας, σας συνιστούμε να τον ανανεώνετε τακτικά."

#: views/password-page.php:82
msgid "New Password:"
msgstr "Νέος κωδικός πρόσβασης:"

#: views/password-page.php:91
msgid "Show password"
msgstr "Εμφάνιση κωδικού πρόσβασης"

#: views/password-page.php:92
msgid "Hide password"
msgstr "Απόκρυψη κωδικού πρόσβασης"

#: views/password-page.php:97
msgid "A strong password has been generated for you. You can use it as-is or change it to your own."
msgstr "Έχει δημιουργηθεί ένας ισχυρός κωδικός πρόσβασης για εσάς. Μπορείτε να τον χρησιμοποιήσετε όπως είναι ή να τον αλλάξετε με δικό σας."

#: views/password-page.php:102
msgid "Update Password"
msgstr "Ενημέρωση κωδικού πρόσβασης"

#: views/password-page.php:111
msgid "Remind Me Later"
msgstr "Υπενθύμισέ μου αργότερα"

#: views/password-page.php:118
#: views/verification-page.php:94
msgid "&larr; Log out"
msgstr "&larr; Αποσύνδεση"

#: views/profile-trusted-devices.php:17
msgid "Two-Factor Authentication"
msgstr "Διπλός έλεγχος ταυτότητας"

#: views/profile-trusted-devices.php:19
msgid "Trusted Devices"
msgstr "Αξιόπιστες συσκευές"

#: views/profile-trusted-devices.php:23
msgid "No trusted devices."
msgstr "Δεν υπάρχουν αξιόπιστες συσκευές."

