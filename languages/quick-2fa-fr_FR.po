#. Plugin Name of the plugin
#: quick-2fa.php
msgid "Quick 2FA"
msgstr "Quick 2FA"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Authentification à deux facteurs légère, par e-mail, pour l'accès à l'interface d'administration de WordPress."

