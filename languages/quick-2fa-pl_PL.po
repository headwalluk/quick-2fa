msgstr "Uwierzytelnianie dwuskładnikowe jest wyłączone. Nie jest zalecane w przypadku witryn produkcyjnych."

#: views/settings-page.php:70
msgid "Enabled for all users"
msgstr "Włączone dla wszystkich użytkowników"

#: views/settings-page.php:71
