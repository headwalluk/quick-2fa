#. translators: %s is the plugin name, Quick 2FA
#: includes/class-plugin.php:772
#, php-format
msgid "%s is currently disabled."
msgstr "%s jest obecnie wyłączone."

#. translators: %s is the plugin name, Quick 2FA
#: includes/class-settings.php:422
#, php-format
msgid "%s Settings"
msgstr "Ustawienia %s"

#: includes/class-abilities.php:66
msgid "Read-only queries about two-factor authentication, passwords and account security."
msgstr "Zapytania tylko do wglądu dotyczące uwierzytelniania dwuskładnikowego, haseł i bezpieczeństwa konta."

#: includes/class-abilities.php:84
msgid "The user: an ID, login name or email address."
msgstr "Użytkownik: identyfikator, nazwa użytkownika lub adres e-mail."

#: includes/class-abilities.php:90
msgid "Get a user's security status"
msgstr "Pobierz informacje o statusie bezpieczeństwa użytkownika"

#: includes/class-abilities.php:91
msgid "Returns when a user last changed their password, logged in and passed two-factor verification, whether two-factor authentication applies to them, whether their account is locked, and how many trusted devices they have. A null date means none has been recorded since Quick 2FA was installed."
msgstr "Zwraca informacje o tym, kiedy użytkownik ostatnio zmienił hasło, zalogował się i przeszedł weryfikację dwuskładnikową, czy uwierzytelnianie dwuskładnikowe ma w jego przypadku zastosowanie, czy jego konto jest zablokowane oraz ile posiada zaufanych urządzeń. Data typu null oznacza, że od momentu zainstalowania aplikacji Quick 2FA nie odnotowano żadnych zdarzeń."

#: includes/class-abilities.php:109
msgid "List users' security status"
msgstr "Wyświetl status bezpieczeństwa użytkowników"

#: includes/class-abilities.php:110
msgid "Lists the security status of many users, such as administrators whose password is older than a year, or staff who have not logged in for 90 days. Without roles, lists users who can edit posts (staff), not customers or subscribers."
msgstr "Wyświetla stan bezpieczeństwa wielu użytkowników, np. administratorów, których hasło ma ponad rok, lub pracowników, którzy nie logowali się od 90 dni. Bez uwzględnienia ról wyświetla użytkowników, którzy mogą edytować posty (pracownicy), a nie klientów ani subskrybentów."

#: includes/class-abilities.php:118
msgid "Only users with one of these role slugs, such as administrator or shop_manager."
msgstr "Tylko użytkownicy posiadający jedną z poniższych nazw ról, np. administrator lub shop_manager."

#: includes/class-abilities.php:123
msgid "Only users whose password is older than this many days. A password with no recorded change is aged from the user's registration."
msgstr "Tylko użytkownicy, których hasło jest starsze o tę liczbę dni. W przypadku hasła, dla którego nie odnotowano żadnej zmiany, okres ważności liczy się od momentu rejestracji użytkownika."

#: includes/class-abilities.php:128
msgid "Only users with no recorded login in this many days, including users with no recorded login at all."
msgstr "Tylko użytkownicy, którzy nie zalogowali się od tylu dni, w tym użytkownicy, którzy nigdy się nie logowali."

#: includes/class-abilities.php:132
msgid "Only users whose account is locked."
msgstr "Tylko użytkownicy, których konto jest zablokowane."

#: includes/class-abilities.php:154
msgid "How many users matched, before limit and offset."
msgstr "Ilu użytkowników pasowało przed uwzględnieniem limitu i przesunięcia."

#: includes/class-abilities.php:172
msgid "Get the two-factor authentication configuration"
msgstr "Pobierz konfigurację uwierzytelniania dwuskładnikowego"

#: includes/class-abilities.php:173
msgid "Returns how Quick 2FA is configured: who must use two-factor authentication, how long verifications and trusted devices last, lockout duration and password reminder settings."
msgstr "Zwraca informacje o konfiguracji funkcji Quick 2FA: kto musi korzystać z uwierzytelniania dwuskładnikowego, jak długo trwają weryfikacje i okres ważności zaufanych urządzeń, czas trwania blokady oraz ustawienia przypomnienia hasła."

#: includes/class-abilities.php:185
msgid "Get a user's security events"
msgstr "Pobierz zdarzenia związane z bezpieczeństwem użytkownika"

#: includes/class-abilities.php:186
msgid "Returns a user's recent security events, newest first: verification codes sent, failed and successful verifications, account locks, password changes and trusted-device revocations. IP addresses and browser details are never returned."
msgstr "Zwraca ostatnie zdarzenia związane z bezpieczeństwem użytkownika, zaczynając od najnowszych: wysłane kody weryfikacyjne, nieudane i udane weryfikacje, blokady konta, zmiany hasła oraz cofnięcia uprawnień zaufanych urządzeń. Adresy IP i szczegóły dotyczące przeglądarki nigdy nie są zwracane."

#: includes/class-abilities.php:204
msgid "Only events of these types."
msgstr "Tylko zdarzenia tego typu."

#: includes/class-abilities.php:239
msgid "You are not allowed to query Quick 2FA."
msgstr "Nie wolno wysyłać zapytań do serwisu Quick 2FA."

#: includes/class-abilities.php:241
msgid "Complete two-factor verification before querying Quick 2FA."
msgstr "Przed wysłaniem zapytania do serwisu Quick 2FA należy przeprowadzić weryfikację dwuskładnikową."

#. translators: %d: the maximum number of users one query may cover
#: includes/class-abilities.php:309
#, php-format
msgid "More than %d users match. Narrow the query with roles."
msgstr "Znaleziono więcej niż %d użytkowników. Zawęź zapytanie, korzystając z ról."

#: includes/class-abilities.php:586
msgid "No user matches that ID, login name or email address."
msgstr "Nie znaleziono użytkownika o tym identyfikatorze, nazwie użytkownika ani adresie e-mail."

#: includes/class-abilities.php:663
msgid "Whether this user must pass two-factor verification to reach the admin area."
msgstr "Czy ten użytkownik musi przejść weryfikację dwuskładnikową, aby uzyskać dostęp do panelu administracyjnego."

#: includes/class-abilities.php:667
msgid "When the password was last changed, or null if no change has been recorded since Quick 2FA was installed."
msgstr "Kiedy hasło zostało zmienione po raz ostatni lub wartość null, jeśli od momentu zainstalowania Quick 2FA nie odnotowano żadnej zmiany."

#: includes/class-abilities.php:671
msgid "Days since the last recorded change, or since registration if none is recorded."
msgstr "Liczba dni od ostatniej odnotowanej zmiany lub od rejestracji, jeśli nie odnotowano żadnej zmiany."

#: includes/class-abilities.php:676
msgid "The last recorded login, or null if none has been recorded; see last_login_recorded_since in the configuration."
msgstr "Ostatnie zarejestrowane logowanie lub wartość null, jeśli żadne nie zostało zarejestrowane; zobacz parametr „last_login_recorded_since” w konfiguracji."

#: includes/class-abilities.php:682
msgid "Whether the lock lasts until an administrator removes it."
msgstr "Czy blokada pozostanie aktywna do momentu jej usunięcia przez administratora."

#: includes/class-abilities.php:704
msgid "Who must use two-factor authentication: every user, the protected roles only, or nobody."
msgstr "Kto musi korzystać z uwierzytelniania dwuskładnikowego: wszyscy użytkownicy, tylko role chronione czy nikt."

#: includes/class-abilities.php:709
msgid "The roles that must use two-factor authentication when the mode is \"roles\"."
msgstr "Role, które muszą korzystać z uwierzytelniania dwuskładnikowego, gdy tryb jest ustawiony na „role”."

#: includes/class-abilities.php:722
msgid "When Quick 2FA began recording logins; earlier logins are unknown."
msgstr "Od momentu, gdy usługa Quick 2FA zaczęła rejestrować logowania; dane dotyczące wcześniejszych logowań nie są znane."

#: includes/class-abilities.php:754
msgid "Event context: source, reason, attempts, success, device_count, locked_until, actor_user_id. Only the fields the event recorded."
msgstr "Kontekst zdarzenia: źródło, przyczyna, próby, powodzenie, liczba_urządzeń, zablokowane_do, identyfikator_użytkownika_sprawcy. Tylko pola zarejestrowane w zdarzeniu."

#: includes/class-abilities.php:758
msgid "Reserved for non-identifying IP metadata such as country; always null in this version."
msgstr "Zarezerwowane dla metadanych adresu IP, które nie pozwalają na identyfikację użytkownika, takich jak kraj; w tej wersji wartość ta jest zawsze zerowa."

#: views/settings-page.php:226
msgctxt "settings section heading; AI software assistants"
msgid "AI Agents"
msgstr "Agenci AI"

#: views/settings-page.php:231
msgctxt "settings field label; the WordPress Abilities API feature"
msgid "Abilities API"
msgstr "Abilities API"

#: views/settings-page.php:234
msgid "Let AI agents query account security"
msgstr "Niech agenci AI sprawdzają bezpieczeństwo kont"

#: views/settings-page.php:235
msgid "Lets an administrator's AI agent ask when users last changed their password, logged in or verified, whether accounts are locked, and for recent security events. Read-only: an agent can never lock, unlock or change anything through Quick 2FA. IP addresses and email addresses are never returned."
msgstr "Umożliwia agentowi AI administratora zapytanie o to, kiedy użytkownicy ostatnio zmienili hasło, zalogowali się lub przeszli weryfikację, czy konta są zablokowane oraz o ostatnie zdarzenia związane z bezpieczeństwem. Tylko do odczytu: agent nigdy nie może blokować, odblokowywać ani zmieniać niczego za pośrednictwem Quick 2FA. Adresy IP i adresy e-mail nigdy nie są zwracane."

#: views/settings-page.php:236
msgid "Needs WordPress 6.9 or later; this site's WordPress has no Abilities API."
msgstr "Wymagana jest wersja WordPress 6.9 lub nowsza; WordPress tej witryny nie posiada interfejsu API Abilities."

#: includes/class-password-reminder-handler.php:151
msgid "That password is too long. Please choose a shorter one."
msgstr "To hasło jest za długie. Wybierz krótsze."

#. translators: %s: Username
#: includes/class-user-management.php:346
#, php-format
msgid "User %s could not be locked out, because the lock could not be saved. Their sessions have been ended. Please try again."
msgstr "Nie udało się zablokować użytkownika %s, ponieważ nie można było zapisać blokady. Jego sesje zostały zakończone. Spróbuj ponownie."

#. translators: %s: Username
#: includes/class-user-management.php:410
#, php-format
msgid "User %s could not be unlocked, because the lock could not be removed. Please try again."
msgstr "Nie udało się odblokować użytkownika %s, ponieważ nie można było usunąć blokady. Spróbuj ponownie."

#: includes/class-account-security-handler.php:675
msgid "The trusted devices could not be removed. Please try again."
msgstr "Nie udało się usunąć zaufanych urządzeń. Spróbuj ponownie."

#. translators: %s: Username
#: includes/class-user-management.php:337
#, php-format
msgid "User %s has been locked out, but their sessions could not all be ended. Please try again."
msgstr "Użytkownik %s został zablokowany, ale nie udało się zakończyć wszystkich jego sesji. Spróbuj ponownie."

#. translators: %s: Username
#: includes/class-user-management.php:355
#, php-format
msgid "User %s could not be locked out, because the lock could not be saved, and their sessions could not all be ended. Please try again."
msgstr "Nie udało się zablokować użytkownika %s, ponieważ nie udało się zapisać blokady i nie udało się zakończyć wszystkich jego sesji. Spróbuj ponownie."

#: includes/class-user-management.php:664
msgid "The trusted device has been revoked."
msgstr "Zaufane urządzenie zostało unieważnione."

#: includes/class-user-management.php:666
msgid "The trusted device could not be revoked, or had already been removed. Check the list and try again."
msgstr "Nie udało się cofnąć uprawnień zaufanego urządzenia lub zostało ono już usunięte. Sprawdź listę i spróbuj ponownie."

#. translators: %d: number of trusted devices revoked
#: includes/class-user-management.php:711
#, php-format
msgid "%d trusted device has been revoked."
msgid_plural "%d trusted devices have been revoked."
msgstr[0] "Odwołano %d zaufane urządzenie."
msgstr[1] "Odwołano %d zaufane urządzenia."
msgstr[2] "Odwołano %d zaufanych urządzeń."
