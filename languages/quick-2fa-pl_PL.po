msgstr "Twój kod weryfikacyjny"

#: functions.php:90
#: views/verification-page.php:59
msgid "For your security, we need to verify your identity before you can access the admin area."
msgstr "Ze względów bezpieczeństwa musimy zweryfikować Twoją tożsamość, zanim uzyskasz dostęp do panelu administracyjnego."

#: functions.php:100
msgid "Regular password changes help keep your account secure. We recommend updating your password every 60 days."
msgstr "Regularna zmiana hasła pomaga zapewnić bezpieczeństwo konta. Zalecamy aktualizowanie hasła co 60 dni."

#: includes/class-email-handler.php:45
msgid "Failed to send verification email. Please contact your site administrator."
msgstr "Nie udało się wysłać wiadomości e-mail z linkiem weryfikacyjnym. Skontaktuj się z administratorem strony."

#: includes/class-password-reminder-handler.php:141
msgid "Please enter a password."
msgstr "Wprowadź hasło."

#: includes/class-password-reminder-handler.php:145
msgid "Password must be at least 8 characters long."
msgstr "Hasło musi mieć co najmniej 8 znaków."

