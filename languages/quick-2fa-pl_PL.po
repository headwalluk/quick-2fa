#. Plugin Name of the plugin
#: quick-2fa.php
msgid "Quick 2FA"
msgstr "Quick 2FA"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Lekkie rozwiązanie do dwuskładnikowego uwierzytelniania oparte na poczcie elektronicznej, przeznaczone do uzyskiwania dostępu do panelu administracyjnego WordPressa."

