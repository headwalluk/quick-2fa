#. Plugin Name of the plugin
#: quick-2fa.php
#: includes/class-settings.php:38
msgid "Quick 2FA"
msgstr "Autenticación de dos factores rápida"

#. Plugin URI of the plugin
#: quick-2fa.php
msgid "https://github.com/headwalluk/quick-2fa"
msgstr "https://github.com/headwalluk/quick-2fa"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Autenticación de dos factores ligera, basada en correo electrónico, para el acceso al panel de administración de WordPress."

#. Author of the plugin
#: quick-2fa.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: quick-2fa.php
msgid "https://headwall-hosting.com"
msgstr "https://headwall-hosting.com"

