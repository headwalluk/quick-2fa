msgstr "https://github.com/create-element/quick-2fa"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Autenticación de dos factores ligera basada en correo electrónico para el acceso de administrador de WordPress."

#. Author of the plugin
#: quick-2fa.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
