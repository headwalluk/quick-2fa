msgstr "Hoe lang een vertrouwd apparaat vertrouwd blijft voordat opnieuw 2FA vereist is (1-365 dagen)."

#: views/settings-page.php:148
msgid "Auto-Lock Duration"
msgstr "Duur van automatische vergrendeling"

#: views/settings-page.php:152
msgid "Duration to lock accounts after too many failed verification attempts (1-1440 minutes = 1 minute to 24 hours)."
msgstr "Duur van het vergrendelen van accounts na te veel mislukte verificatiepogingen (1-1440 minuten = 1 minuut tot 24 uur)."

