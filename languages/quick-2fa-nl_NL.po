#. Plugin Name of the plugin
#: quick-2fa.php
#: includes/class-settings.php:38
msgid "Quick 2FA"
msgstr "Snelle 2FA"

#. Plugin URI of the plugin
#: quick-2fa.php
msgid "https://github.com/create-element/quick-2fa"
msgstr "https://github.com/create-element/quick-2fa"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Lichtgewicht e-mailgebaseerde tweefactorauthenticatie voor WordPress-beheerders toegang."

#. Author of the plugin
#: quick-2fa.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
#: quick-2fa.php
msgid "https://power-plugins.com"
msgstr "https://power-plugins.com"

