#. Plugin Name of the plugin
#: quick-2fa.php
#: includes/class-settings.php:38
msgid "Quick 2FA"
msgstr "Snelle tweefactorauthenticatie"

#. Plugin URI of the plugin
#: quick-2fa.php
msgid "https://github.com/headwalluk/quick-2fa"
msgstr "https://github.com/headwalluk/quick-2fa"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Eenvoudige tweefactorauthenticatie via e-mail voor toegang tot het WordPress-beheerdersgedeelte."

#. Author of the plugin
#: quick-2fa.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. translators: %s: User display name
#: emails/verification-code.php:20
#, php-format
msgid "Hi %s,"
msgstr "Hallo %s,"

#. translators: %s: Verification code
#: emails/verification-code.php:27
#, php-format
msgid "Your verification code is: %s"
msgstr "Je verificatiecode is: %s"

#. translators: %d: Number of minutes
#: emails/verification-code.php:34
#, php-format
msgid "This code will expire in %d minutes."
msgstr "Deze code verloopt over %d minuten."

#: emails/verification-code.php:39
msgid "If you did not request this code, please contact your site administrator immediately."
msgstr "Als u deze code niet hebt aangevraagd, neem dan onmiddellijk contact op met uw sitebeheerder."

#: functions-private.php:44
#: includes/class-email-handler.php:38
#: includes/class-settings.php:352
msgid "Your verification code"
msgstr "Uw verificatiecode"

#: functions-private.php:124
msgid "For your security, we need to verify your identity before you can access the admin area."
msgstr "Omwille van uw veiligheid moeten we uw identiteit verifiëren voordat u toegang krijgt tot het beheerdersgedeelte."

#: functions-private.php:153
msgid "Regular password changes help keep your account secure. We recommend updating your password every 60 days."
msgstr "Door uw wachtwoord regelmatig te wijzigen, blijft uw account veilig. We raden u aan uw wachtwoord elke 60 dagen te wijzigen."

#: includes/class-email-handler.php:45
msgid "Failed to send verification email. Please contact your site administrator."
msgstr "Het is niet gelukt om de verificatiemail te versturen. Neem contact op met de beheerder van de site."

#: includes/class-password-reminder-handler.php:141
msgid "Please enter a password."
msgstr "Voer een wachtwoord in."

#: includes/class-password-reminder-handler.php:145
msgid "Password must be at least 8 characters long."
msgstr "Het wachtwoord moet uit minimaal 8 tekens bestaan."

#: includes/class-plugin.php:165
#: includes/class-plugin.php:200
msgid "Your account has been locked. Please contact your site administrator."
msgstr "Uw account is geblokkeerd. Neem contact op met de beheerder van de site."

#. translators: %s: Time remaining until unlock
#: includes/class-plugin.php:169
#: includes/class-plugin.php:204
#, php-format
msgid "Your account has been locked. Please try again in %s."
msgstr "Uw account is geblokkeerd. Probeer het over %s nog eens."

#: includes/class-plugin.php:209
msgid "Account Locked"
msgstr "Account geblokkeerd"

#: includes/class-plugin.php:423
msgid "Invalid action"
msgstr "Ongeldige actie"

