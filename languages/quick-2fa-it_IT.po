#. Plugin Name of the plugin
#: quick-2fa.php
msgid "Quick 2FA"
msgstr "Quick 2FA"

#. Description of the plugin
#: quick-2fa.php
msgid "Lightweight email-based two-factor authentication for WordPress admin access."
msgstr "Autenticazione a due fattori leggera, basata su e-mail, per l'accesso all'area di amministrazione di WordPress."

